# ============================================================================
# apiplatform — environment configuration (copy to .env)
# ============================================================================

# --- Server ---
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Public base URL of this server (used for generated links, docs, mock URLs)
APP_URL=http://localhost:4000

# Comma-separated list of allowed CORS origins (the web dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistence ---
# SQLite database file path (uses Node.js built-in node:sqlite — no native deps).
DATABASE_PATH=./data/apiplatform.db

# --- Auth ---
# Secret used to sign JWTs. MUST be changed in production (min 32 chars).
JWT_SECRET=change-me-to-a-long-random-secret-32chars
JWT_TTL=24h

# --- Secret vault ---
# 32-byte base64 key used to encrypt the local secret vault at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=

# --- AI / Agent Mode (Bring Your Own Model Provider) ---
# Global default provider. Leave empty to use per-workspace / per-user providers only.
AI_DEFAULT_PROVIDER=
AI_DEFAULT_BASE_URL=
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Request execution ---
REQUEST_EXECUTION_TIMEOUT_MS=30000
SCRIPT_TIMEOUT_MS=3000
MAX_REDIRECTS=10
MAX_RESPONSE_CAPTURE_BYTES=2097152